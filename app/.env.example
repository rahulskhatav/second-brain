# Copy to .env and fill in. The server reads this file at startup.

# Postgres. On Vercel this is set for you when you attach a database — locally,
# paste the same POOLED connection string here (the one with "-pooler" in the
# host). Required: there is no local-file fallback.
DATABASE_URL=

# Gemini API key — get one at https://aistudio.google.com/apikey
# Without it the app still runs: summaries fall back to an extractive
# summariser and embeddings to a deterministic lexical vector.
GEMINI_API_KEY=

# Models (optional overrides)
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Signing key for session cookies. Change it for anything real.
SESSION_SECRET=change-me-in-production

PORT=8787

# PostHog (optional — analytics is off entirely without these).
# Same project API key in both: the VITE_ one is read at BUILD time and ends up
# in the browser bundle, which is what a PostHog project key is designed for.
# Set the host to https://eu.i.posthog.com if your project is on EU cloud.
VITE_POSTHOG_KEY=phc_CtUirwVWAMeRHc7xhwZGYqWjuX3FT7r8bxwY2ZHy39j8
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=phc_CtUirwVWAMeRHc7xhwZGYqWjuX3FT7r8bxwY2ZHy39j8
POSTHOG_HOST=https://us.i.posthog.com
